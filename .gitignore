# 依赖与包管理器缓存；保留依赖锁文件
node_modules/
.npm/
.pnpm-store/

# 构建、开发运行目录与安装包
/dist/
/work/
/artifacts/
*.tgz

# 测试报告、覆盖率与工具缓存
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
.cache/
.eslintcache
*.tsbuildinfo

# 日志与性能诊断
*.log
*.cpuprofile
*.heapprofile
*.heapsnapshot
/report.*.json

# 本地环境配置；示例文件可入库
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# 编辑器个人文件；保留可共享的 VS Code 配置
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/*.code-snippets
*.code-workspace
*.swp
*.swo
*~

# 操作系统生成文件
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# native/ 中随包分发的动态库、资源和许可证需要入库，不按扩展名忽略
