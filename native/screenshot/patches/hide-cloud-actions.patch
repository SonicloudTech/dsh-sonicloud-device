@@ -0,0 +1,73 @@
+#include <QtTest/QtTest>
+#include <QtWidgets>
+#include <PixPinScrollCapture.h>
+#include "../core/screen_label.h"
+#include "../core/helper_config.h"
+
+class TestCloudActions : public QObject
+{
+    Q_OBJECT
+private slots:
+    void hideUnsupportedActionsAndKeepScroll();
+    void refreshWordActionFromCurrentConfig();
+};
+
+static QPushButton* button(ScreenToolBar& bar, const QString& tip)
+{
+    for (auto* candidate : bar.findChildren<QPushButton*>())
+        if (candidate->toolTip() == tip) return candidate;
+    return nullptr;
+}
+
+void TestCloudActions::hideUnsupportedActionsAndKeepScroll()
+{
+    HelperConfig::instance().apply(QJsonObject{{"ocr_visible", false}, {"trans_enabled", false}});
+    ScreenToolBar bar;
+    bar.initBar();
+    auto* ocr = button(bar, QStringLiteral("OCR"));
+    auto* translate = button(bar, QStringLiteral("Translate"));
+    auto* scroll = button(bar, QStringLiteral("Scroll screenshot"));
+    QVERIFY(ocr && translate && scroll);
+    QVERIFY(ocr->isHidden());
+    QVERIFY(translate->isHidden());
+    QVERIFY(!scroll->isHidden());
+    const int hiddenWidth = bar.width();
+    bar.setPinEditMode(true);
+    bar.setPinEditMode(false);
+    QVERIFY(translate->isHidden());
+    QVERIFY(ocr->isHidden());
+    QVERIFY(!scroll->isHidden());
+    HelperConfig::instance().apply(QJsonObject{{"ocr_visible", true}, {"trans_enabled", true}});
+    bar.initBar();
+    QVERIFY(!ocr->isHidden());
+    QVERIFY(!translate->isHidden());
+    QCOMPARE(bar.width() - hiddenWidth, 96);
+}
+
+void TestCloudActions::refreshWordActionFromCurrentConfig()
+{
+    HelperConfig::instance().apply(QJsonObject{{"ocr_visible", true}});
+    ScreenLabel label;
+    auto count = [&label](const QString& name) {
+        int count = 0;
+        for (const auto& action : label.m_scrollCaptureParams.actions)
+            if (action.name == name) ++count;
+        return count;
+    };
+    QCOMPARE(count(QStringLiteral("OCR")), 1);
+    PixPinScrollCapture::Action copy;
+    copy.name = "copy";
+    label.m_scrollCaptureParams.actions.append(copy);
+    HelperConfig::instance().apply(QJsonObject{{"ocr_visible", false}});
+    label.refreshScrollActions();
+    QCOMPARE(count(QStringLiteral("OCR")), 0);
+    QCOMPARE(count(QStringLiteral("copy")), 1);
+    HelperConfig::instance().apply(QJsonObject{{"ocr_visible", true}});
+    label.refreshScrollActions();
+    label.refreshScrollActions();
+    QCOMPARE(count(QStringLiteral("OCR")), 1);
+    QCOMPARE(count(QStringLiteral("copy")), 1);
+}
+
+QTEST_MAIN(TestCloudActions)
+#include "test_cloud_actions.moc"
