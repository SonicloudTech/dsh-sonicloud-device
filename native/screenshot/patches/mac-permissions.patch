+void HelperGateway::requestPermission(const QString& permission)
+{
+    if (permission != QLatin1String("screen") && permission != QLatin1String("accessibility"))
+    {
+        sendEvent(QJsonObject{{"type", "error"},
+                              {"code", QStringLiteral("permission_request_invalid")},
+                              {"message", QStringLiteral("Unknown permission request")}});
+        return;
+    }
+    if (m_capturing || m_pinEditing)
+    {
+        sendStateReport();
+        sendEvent(QJsonObject{{"type", "error"},
+                              {"code", QStringLiteral("permission_request_busy")},
+                              {"message", QStringLiteral("Finish capture or pin editing before permission setup")}});
+        return;
+    }
+#ifdef Q_OS_MAC
+    QTimer::singleShot(0, this, [this, permission] {
+        // A capture can start between receiving the command and this callback.
+        if (m_capturing || m_pinEditing)
+        {
+            sendStateReport();
+            sendEvent(QJsonObject{{"type", "error"},
+                                  {"code", QStringLiteral("permission_request_busy")},
+                                  {"message", QStringLiteral("Finish capture or pin editing before permission setup")}});
+            return;
+        }
+        if (permission == QLatin1String("screen") && !screenPermissionGranted())
+            promptScreenPermission();
+        else if (permission == QLatin1String("accessibility") && !accessibilityPermissionGranted())
+            promptAccessibilityPermission();
+        // Requesting is asynchronous; this reports status, never a grant promise.
+        sendStateReport();
+    });
+#else
+    sendEvent(QJsonObject{{"type", "error"},
+                          {"code", QStringLiteral("permission_request_unsupported")},
+                          {"message", QStringLiteral("Permission setup is only available on macOS")}});
+#endif
+}
