+#include <QtTest/QtTest>
+#include <QJsonArray>
+#include <QJsonObject>
+#include "../ipc/helper_gateway.h"
+
+class PermissionGateway : public HelperGateway
+{
+public:
+    bool screen = false;
+    bool accessibility = false;
+    int screenRequests = 0;
+    int accessibilityRequests = 0;
+    int captureStarts = 0;
+    QList<QJsonObject> events;
+    void dispatch(const QJsonObject& value)
+    {
+        QVERIFY(QMetaObject::invokeMethod(this, "onFrame", Qt::DirectConnection,
+            Q_ARG(QJsonObject, value), Q_ARG(QByteArray, QByteArray())));
+    }
+    QJsonObject last(const QString& type) const
+    {
+        for (auto i = events.crbegin(); i != events.crend(); ++i)
+            if (i->value("type").toString() == type) return *i;
+        return {};
+    }
+protected:
+    bool screenPermissionGranted() const override { return screen; }
+    bool accessibilityPermissionGranted() const override { return accessibility; }
+    void promptScreenPermission() override { ++screenRequests; }
+    void promptAccessibilityPermission() override { ++accessibilityRequests; }
+    void beginCapture() override { ++captureStarts; sendEvent(QJsonObject{{"type", "session_started"}}); }
+    void sendEvent(const QJsonObject& header, const QByteArray& = QByteArray()) override { events.append(header); }
+};
+
+class TestMacPermissions : public QObject
+{
+    Q_OBJECT
+private slots:
+    void missingScreenNeverCreatesOverlay();
+    void optionalAccessibilityDoesNotBlockCapture();
+    void stateAndCapabilityReport();
+    void requestValidationAndBusyGuard();
+    void explicitRequestsNeverPretendGranted();
+    void busyRaceDoesNotPrompt();
+};
+
+void TestMacPermissions::missingScreenNeverCreatesOverlay()
+{
+    PermissionGateway gateway;
+    gateway.dispatch(QJsonObject{{"type", "start_capture"}});
+    QCOMPARE(gateway.captureStarts, 0);
+    QVERIFY(gateway.m_label == nullptr);
+    QVERIFY(!gateway.m_capturing);
+    QVERIFY(gateway.last("session_started").isEmpty());
+    QCOMPARE(gateway.last("session_ended").value("reason").toString(), QStringLiteral("permission_required"));
+    QCOMPARE(gateway.last("error").value("code").toString(), QStringLiteral("permission_screen_required"));
+    QVERIFY(!gateway.last("state_report").value("perm_screen").toBool());
+}
+
+void TestMacPermissions::optionalAccessibilityDoesNotBlockCapture()
+{
+    PermissionGateway gateway;
+    gateway.screen = true;
+    gateway.accessibility = false;
+    gateway.dispatch(QJsonObject{{"type", "start_capture"}});
+    QCOMPARE(gateway.captureStarts, 1);
+    QVERIFY(gateway.last("error").isEmpty());
+    QCOMPARE(gateway.accessibilityRequests, 0);
+}
+
+void TestMacPermissions::stateAndCapabilityReport()
+{
+    PermissionGateway gateway;
+    gateway.dispatch(QJsonObject{{"type", "hello"}});
+    QVERIFY(gateway.last("hello_ack").value("capabilities").toArray().contains(QStringLiteral("permission_preflight")));
+    gateway.m_pinEditing = true;
+    gateway.dispatch(QJsonObject{{"type", "query_state"}});
+    const auto report = gateway.last("state_report");
+    QVERIFY(report.contains("perm_screen"));
+    QVERIFY(report.contains("perm_a11y"));
+    QVERIFY(report.value("pin_editing").toBool());
+    QVERIFY(gateway.m_label == nullptr);
+    gateway.m_pinEditing = false;
+}
+
+void TestMacPermissions::requestValidationAndBusyGuard()
+{
+    PermissionGateway gateway;
+    for (const auto& value : QList<QJsonValue>{QJsonValue(""), QJsonValue("both"), QJsonValue(true), QJsonValue(1), QJsonValue(QJsonObject{})})
+    {
+        gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", value}});
+        QCOMPARE(gateway.last("error").value("code").toString(), QStringLiteral("permission_request_invalid"));
+    }
+    for (const bool editing : {false, true})
+    {
+        gateway.m_capturing = !editing;
+        gateway.m_pinEditing = editing;
+        gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", "screen"}});
+        QCOMPARE(gateway.last("error").value("code").toString(), QStringLiteral("permission_request_busy"));
+    }
+    gateway.m_capturing = false;
+    gateway.m_pinEditing = false;
+    QCoreApplication::processEvents();
+    QCOMPARE(gateway.screenRequests, 0);
+    QCOMPARE(gateway.accessibilityRequests, 0);
+    QVERIFY(gateway.m_label == nullptr);
+}
+
+void TestMacPermissions::explicitRequestsNeverPretendGranted()
+{
+    PermissionGateway gateway;
+    gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", "screen"}});
+    QTRY_COMPARE(gateway.screenRequests, 1);
+    QVERIFY(!gateway.last("state_report").value("perm_screen").toBool());
+    gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", "accessibility"}});
+    QTRY_COMPARE(gateway.accessibilityRequests, 1);
+    QVERIFY(!gateway.last("state_report").value("perm_a11y").toBool());
+    QCOMPARE(gateway.captureStarts, 0);
+    QVERIFY(gateway.m_label == nullptr);
+    gateway.screen = true;
+    gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", "screen"}});
+    QCoreApplication::processEvents();
+    QCOMPARE(gateway.screenRequests, 1);
+    QVERIFY(gateway.last("state_report").value("perm_screen").toBool());
+}
+
+void TestMacPermissions::busyRaceDoesNotPrompt()
+{
+    PermissionGateway gateway;
+    gateway.dispatch(QJsonObject{{"type", "set_config"}, {"permission_request", "screen"}});
+    gateway.m_capturing = true;
+    QCoreApplication::processEvents();
+    QCOMPARE(gateway.screenRequests, 0);
+    QCOMPARE(gateway.last("error").value("code").toString(), QStringLiteral("permission_request_busy"));
+    gateway.m_capturing = false;
+}
+
+QTEST_MAIN(TestMacPermissions)
+#include "test_mac_permissions.moc"
